+        sLastKey = k; sLastKeyT = now;
+        Serial.printf("[keypad] key '%c'  (%s)\n", k, keyMeaning(k));
+      }
+      if (millis() - sLastKeyT > 2000 && sLastKey) sLastKey = 0;   // stop repeating
+    }
