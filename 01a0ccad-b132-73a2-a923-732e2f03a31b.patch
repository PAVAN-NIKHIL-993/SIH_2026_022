+// instances live in control.cpp: sensors, battery, dryer, cfg
+
+static void printBanner() {
+  Serial.println(F("\n========================================="));
+  Serial.printf("  SMART DEHUMMIDIFIER PILLAR  v%s\n", FW_VERSION);
+  Serial.println(F("  550W solar - ESP32 + BTS7960 + L298N"));
+  Serial.println(F("========================================="));
+}
