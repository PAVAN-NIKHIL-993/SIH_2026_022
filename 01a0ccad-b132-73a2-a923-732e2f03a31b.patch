+static void handleManualHeat() {   // web knob: /api/heat?d=0..100
+  if (!server.hasArg("d")) { server.send(400, "text/plain", "d?"); return; }
+  int d = server.arg("d").toInt();
+  if (d < 0) d = 0;
+  if (d > 100) d = 100;
+  dryer.setManualHeat((uint8_t)d);
+  server.send(200, "text/plain", "ok");
