+void clockTick() {            // periodic persistence (call from loop/handle)
+  static uint32_t last = 0;
+  uint32_t now = millis();
+  if (last != 0 && now - last < TIME_SAVE_MS) return;
+  last = now ? now : 1;
+  time_t t = time(nullptr);
+  if (sClockSynced && t > (time_t)1700000000) clockSave((uint32_t)t);
+}
