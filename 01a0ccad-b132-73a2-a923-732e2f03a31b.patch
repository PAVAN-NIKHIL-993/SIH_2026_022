+// Resting-voltage approximations - good enough for a dryer dashboard.
+static const BatteryProfile kProfiles[] = {
+  { "3S Li-ion",  12.6f,  9.90f },   // 0
+  { "4S Li-ion",  16.8f, 13.20f },   // 1
+  { "12V SLA",    12.9f, 11.70f },   // 2
