+  $('bgSwatches').innerHTML=BGP.map(b=>
+    '<span class="bgsw" style="background:'+b.c+'" title="'+b.n+
+    '" onclick="bgApply(\''+b.c+'\',bgCur.lines)"></span>').join('');
