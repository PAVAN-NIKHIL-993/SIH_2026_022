+def rect_point(b, tx, ty):     # border intersection of center->(tx,ty)
+    cx, cy = b['x'] + b['w'] / 2, b['y'] + b['h'] / 2
+    dx, dy = tx - cx, ty - cy
+    if dx == 0 and dy == 0:
+        return cx, cy
+    t = min((b['w'] / 2) / abs(dx) if dx else 1e9, (b['h'] / 2) / abs(dy) if dy else 1e9)
+    return cx + dx * t, cy + dy * t
