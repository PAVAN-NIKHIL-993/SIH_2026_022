<mxfile host="app.diagrams.net" version="24.7.5"><diagram id="page0" name="1 · System Design"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;SMART DEHUMMIDIFIER PILLAR — FULL SYSTEM DESIGN&lt;/b&gt;&lt;br&gt;v2.1 max-PCF architecture · one ESP32-S3 does everything" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="46" as="geometry" /></mxCell><mxCell id="solar" value="&lt;b&gt;550 W SOLAR PANEL&lt;/b&gt;&lt;br&gt;24 V nominal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="76" width="220" height="54" as="geometry" /></mxCell><mxCell id="mppt" value="&lt;b&gt;MPPT CONTROLLER&lt;/b&gt;&lt;br&gt;20 A+ · 12 V side" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="292" y="76" width="220" height="54" as="geometry" /></mxCell><mxCell id="batt" value="&lt;b&gt;LiFePO4 4S 50–100 Ah&lt;/b&gt;&lt;br&gt;BMS ≥ 50 A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="544" y="76" width="220" height="54" as="geometry" /></mxCell><mxCell id="fuse" value="&lt;b&gt;50 A FUSE&lt;/b&gt;&lt;br&gt;heater rail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="796" y="76" width="220" height="54" as="geometry" /></mxCell><mxCell id="latch" value="&lt;b&gt;P-MOSFET LATCH — hard power-off&lt;/b&gt;&lt;br&gt;hold = GPIO14 · BUTTON-1: 3 s off / 10 s reboot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="320" height="64" as="geometry" /></mxCell><mxCell id="bus" value="12 V POWER BUS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="252" width="680" height="36" as="geometry" /></mxCell><mxCell id="bts" value="&lt;b&gt;BTS7960 43 A + 555 shifter&lt;/b&gt;&lt;br&gt;RPWM = 12 · EN = 13&lt;br&gt;→ 500 W coil (0.32 Ω)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="280" height="64" as="geometry" /></mxCell><mxCell id="l298" value="&lt;b&gt;L298N&lt;/b&gt;&lt;br&gt;ENB = 17 (fan PWM)&lt;br&gt;IN3/IN4 tied on the module (v2.0.10)&lt;br&gt;→ OUTLET fan (burst law)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="320" width="280" height="64" as="geometry" /></mxCell><mxCell id="buck" value="&lt;b&gt;5 V BUCK (set 5.0 V first)&lt;/b&gt;&lt;br&gt;→ ESP32 · relays · HX711 · keypad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="320" width="280" height="64" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;ESP32-S3 DevKitC&lt;/b&gt;&lt;br&gt;(the brain · zero libraries)&lt;br&gt;&lt;br&gt;BOOT btn = 0 (start/stop)&lt;br&gt;latch hold = 14&lt;br&gt;I2C0 = 8 / 9 (I2C1 free)&lt;br&gt;HX711 = 1 / 2&lt;br&gt;battery = ADC 4 · gate 5&lt;br&gt;heater = RPWM 12 · EN 13&lt;br&gt;fan ENB = 17&lt;br&gt;door = 21 · DHT11 = 41&lt;br&gt;DHT22 = 10 · opto = 18&lt;br&gt;relays = 6 / 7 · toggle = 39&lt;br&gt;buttons = 15 / 16&lt;br&gt;buzzer = 38 · pixel = 48&lt;br&gt;RTC DS1302 = 40 / 42 / 47&lt;br&gt;&lt;br&gt;(no display — the website&lt;br&gt;is the screen, v2.0.7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="430" width="300" height="560" as="geometry" /></mxCell><mxCell id="i2c0" value="I2C0 BUS — GPIO 8 / 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="300" height="34" as="geometry" /></mxCell><mxCell id="aht1" value="&lt;b&gt;AHT10 (0x38)&lt;/b&gt;&lt;br&gt;chamber TOP · temp/RH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="474" width="300" height="54" as="geometry" /></mxCell><mxCell id="pcf1" value="&lt;b&gt;PCF8574 #1 @ 0x20 — KEYPAD 4×4&lt;/b&gt;&lt;br&gt;B menu · 2/4/6/8 arrows · A OK&lt;br&gt;C mode · D run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="538" width="300" height="64" as="geometry" /></mxCell><mxCell id="pcf2" value="&lt;b&gt;PCF8574 #2 @ 0x21 — FRONT PANEL (mixed)&lt;/b&gt;&lt;br&gt;P0/P1 → supply relay CH1/CH2 (active-LOW)&lt;br&gt;P2/P3 → BUTTON-1 / BUTTON-2&lt;br&gt;P4 → SOLAR toggle · P5 → opto&lt;br&gt;P6 → door limit switch · P7 → buzzer&lt;br&gt;(10 kΩ pull-ups on all pins)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="612" width="300" height="100" as="geometry" /></mxCell><mxCell id="freed" value="&lt;b&gt;SPARE S3 GPIOs (no display)&lt;/b&gt;&lt;br&gt;frees 6 · 7 · 38 · 15 · 16 · 39 · 18 · 21&lt;br&gt;after PCF #2 lands&lt;br&gt;today free: 3 · 11&lt;br&gt;40/42/47 = DS1302 RTC (v2.0.21)&lt;br&gt;41 = DHT11 · 48 = pixel · 35/36/37 = R8 PSRAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="722" width="300" height="94" as="geometry" /></mxCell><mxCell id="loads2" value="&lt;b&gt;DRIVEN VIA PCF #2&lt;/b&gt;&lt;br&gt;2-CH SUPPLY RELAY — CH1 solar / CH2 bypass&lt;br&gt;(never both · switch only with loads quiet)&lt;br&gt;BUZZER KY-012 (low-side: + to 3V3)&lt;br&gt;BUTTONS / TOGGLE / OPTO / DOOR read back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="828" width="300" height="110" as="geometry" /></mxCell><mxCell id="aht2" value="&lt;b&gt;DHT22 · cool-return path&lt;/b&gt;&lt;br&gt;GPIO10 + 10k · chamber source #2&lt;br&gt;(I2C1 free, GPIO11 spare)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="430" width="280" height="54" as="geometry" /></mxCell><mxCell id="hx711" value="&lt;b&gt;HX711 + 2×5 kg load cells&lt;/b&gt;&lt;br&gt;CLK = 1 · DOUT = 2 · dry-to-weight&lt;br&gt;cells OUTSIDE the hot chamber" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="494" width="280" height="74" as="geometry" /></mxCell><mxCell id="divider" value="&lt;b&gt;BATTERY DIVIDER&lt;/b&gt;&lt;br&gt;100k / 15k → ADC 4&lt;br&gt;gate = GPIO5 (2N7000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="578" width="280" height="64" as="geometry" /></mxCell><mxCell id="phone" value="&lt;b&gt;ANY PHONE (browser only)&lt;/b&gt;&lt;br&gt;WiFi AgarbattiDryer / dryer1234&lt;br&gt;http://192.168.4.1&lt;br&gt;dashboard · parameters · history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="866" width="280" height="84" as="geometry" /></mxCell><mxCell id="pcbox" value="&lt;b&gt;PC — Arduino IDE&lt;/b&gt;&lt;br&gt;network OTA:&lt;br&gt;smart-dryer at 192.168.4.1&lt;br&gt;or USB serial 115200" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="960" width="280" height="74" as="geometry" /></mxCell><mxCell id="safety" value="&lt;b&gt;SAFETY CHAIN — always armed&lt;/b&gt;&lt;br&gt;95 °C hard cut · both sensors dead 15 s · heater failure (temp flat 3 min) · fan error (RH ≥ 60 % for 5 min)&lt;br&gt;door opened mid-cycle = instant FAULT · battery ≤ 10 % safe shutdown · purge before every power cut&lt;br&gt;OTA refused while RUNNING · START refused until the scale is calibrated · unused pins parked safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1140" width="1000" height="130" as="geometry" /></mxCell><mxCell id="modes" value="&lt;b&gt;MODES — C key / BUTTON-2 / website&lt;/b&gt;&lt;br&gt;AGARBATTI 60 °C · USER DEFINED · SILICAGEL 80 °C&lt;br&gt;setTemp clamped 40–80 °C (hard cut 95 °C)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="480" height="80" as="geometry" /></mxCell><mxCell id="beeps" value="&lt;b&gt;BEEP LANGUAGE&lt;/b&gt;&lt;br&gt;start 3 s · end 5 s · power-on 2/s × 3 s&lt;br&gt;error 5 s · door 1 s · mode change 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1290" width="480" height="80" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;BUILD NOTES&lt;/b&gt;&lt;br&gt;• Buy PCF8574 — never PCF8574A (0x38 = AHT10 clash) · addresses 0x20 / 0x21 / 0x22 · AT24C256 0x50 (cycle registry)&lt;br&gt;• DevKitC N8/N16/N16R8 all work — pin map avoids GPIO 35/36/37 (PSRAM on R8)&lt;br&gt;• All grounds common at ONE star point · buck set to 5.0 V before the ESP32 connects&lt;br&gt;• Battery gate (GPIO5), latch hold (14), RPWM (12), ADC (4), HX711 (1/2) stay DIRECT on the S3 —&lt;br&gt;  everything slow (clicks, beeps, switches, presses) lives on the PCFs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1000" height="150" as="geometry" /></mxCell><mxCell id="p2ref" value="OPERATING WORKFLOW  (power-on → calibrate → load → dry → done)  →  PAGE 2 of this file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="1000" height="44" as="geometry" /></mxCell><mxCell id="e0_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="solar" target="mppt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="mppt" target="batt"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="batt" target="fuse"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="fuse" target="latch"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="latch" target="bus"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="bus" target="bts"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="bus" target="l298"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="bus" target="buck"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="aht1" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="pcf1" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="pcf2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="pcf2" target="loads2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="aht2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="hx711" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="divider" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_15" value="hotspot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="s3" target="phone"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e0_16" value="OTA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="s3" target="pcbox"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page1" name="2 · Operating Workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="&lt;b&gt;POWER ON — press BUTTON-1&lt;/b&gt;&lt;br&gt;P-MOSFET latch feeds the pillar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="30" width="300" height="56" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;ALL PINS LOW&lt;/b&gt;&lt;br&gt;outputs safe · unused pads parked" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="112" width="300" height="56" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;SPLASH + POWER-ON BEEPS&lt;/b&gt;&lt;br&gt;SELF-TEST [diag]&lt;br&gt;10 s INIT + CALIBRATION window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="194" width="300" height="72" as="geometry" /></mxCell><mxCell id="p3" value="&lt;b&gt;ENGAGE — supply relay = toggle&lt;/b&gt;&lt;br&gt;(start gate per calibration state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="292" width="300" height="56" as="geometry" /></mxCell><mxCell id="d1" value="&lt;b&gt;scale&lt;/b&gt;&lt;br&gt;calibrated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="374" width="260" height="110" as="geometry" /></mxCell><mxCell id="cal" value="&lt;b&gt;START LOCKED — CALIBRATE&lt;/b&gt;&lt;br&gt;tare, then known weight (e.g. 1000 g)&lt;br&gt;website Calibrate / serial cal 1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="384" width="280" height="90" as="geometry" /></mxCell><mxCell id="p4" value="&lt;b&gt;GATE OPEN — LOAD THE TRAYS&lt;/b&gt;&lt;br&gt;then CLOSE the door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="516" width="300" height="56" as="geometry" /></mxCell><mxCell id="p5" value="&lt;b&gt;BATCH WEIGHED (diff vs tare)&lt;/b&gt;&lt;br&gt;READY: n g on screen + site&lt;br&gt;(empty / overload warned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="598" width="300" height="72" as="geometry" /></mxCell><mxCell id="p6" value="&lt;b&gt;START — D key · website ·&lt;/b&gt;&lt;br&gt;BUTTON-2 · BOOT button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="696" width="300" height="56" as="geometry" /></mxCell><mxCell id="p7" value="&lt;b&gt;RUNNING — OPEN DOOR = FAULT&lt;/b&gt;&lt;br&gt;full-power heat-up → PID hold&lt;br&gt;setTemp 40–80 °C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="778" width="300" height="72" as="geometry" /></mxCell><mxCell id="p8" value="&lt;b&gt;FAN BURST LAW&lt;/b&gt;&lt;br&gt;RH ≥ 60 % for 1 min → fan 100 % for 60 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="300" height="56" as="geometry" /></mxCell><mxCell id="p9" value="&lt;b&gt;TARGET WEIGHT&lt;/b&gt;&lt;br&gt;cur / tgt / diff live · warn at T-5 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="962" width="300" height="56" as="geometry" /></mxCell><mxCell id="fault" value="&lt;b&gt;FAULTS — beep 5 s&lt;/b&gt;&lt;br&gt;95 °C cut&lt;br&gt;heater failure (flat 3 min)&lt;br&gt;fan error (RH ≥ 60 % 5 min)&lt;br&gt;door opened mid-cycle&lt;br&gt;both sensors dead&lt;br&gt;battery ≤ 10 %" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="778" width="280" height="170" as="geometry" /></mxCell><mxCell id="d3" value="time up?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1044" width="260" height="100" as="geometry" /></mxCell><mxCell id="d4" value="&lt;b&gt;within 5 %&lt;/b&gt;&lt;br&gt;of target?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="1176" width="260" height="110" as="geometry" /></mxCell><mxCell id="done1" value="DONE — purge 45 s (fan 100 %)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="1322" width="300" height="56" as="geometry" /></mxCell><mxCell id="done2" value="&lt;b&gt;DONE-WITH-WARNING — target missed&lt;/b&gt;&lt;br&gt;flag on site/CSV + warn beep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="1322" width="320" height="56" as="geometry" /></mxCell><mxCell id="p10" value="&lt;b&gt;POWER CUT (relay) · UNLOCK&lt;/b&gt;&lt;br&gt;UNLOAD — CSV saved (wt_g · mode · target)" style="rounded=1;whiteSpace=wrap;html=1;