block;strokeColor=#595959;" edge="1" parent="1" source="p9" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_13" value="no — keep drying" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="d3" target="p7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_14" value="any fault" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="p7" target="fault"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_15" value="purge → power off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="fault" target="p10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_16" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_17" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="d4" target="done1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_18" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#d79b00;" edge="1" parent="1" source="d4" target="done2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="done1" target="p10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="done2" target="p10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="p10" target="p11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1_22" value="reload trays" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="p11" target="p4"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="3 · Code Workflow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1_" value="&lt;b&gt;SMART DEHUMMIDIFIER — CODE WORKFLOW&lt;/b&gt;&lt;br&gt;firmware v2.x · zero libraries · every step mapped to its component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1000" height="46" as="geometry" /></mxCell><mxCell id="boothdr" value="① BOOT — setup() → initSystem()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="76" width="300" height="40" as="geometry" /></mxCell><mxCell id="b1" value="&lt;b&gt;supply::begin — LATCH HOLD GPIO14&lt;/b&gt;&lt;br&gt;asserted within ms (or power dies)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="300" height="50" as="geometry" /></mxCell><mxCell id="b2" value="&lt;b&gt;pinsUnusedSafe — every unused pad&lt;/b&gt;&lt;br&gt;parked (pull-up / input)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="192" width="300" height="50" as="geometry" /></mxCell><mxCell id="b3" value="relay outputs OFF — ALL PINS LOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="254" width="300" height="50" as="geometry" /></mxCell><mxCell id="b4" value="printBanner + loadSettings — NVS v7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="316" width="300" height="50" as="geometry" /></mxCell><mxCell id="b5" value="&lt;b&gt;sensors.begin — AHT10 top +&lt;/b&gt;&lt;br&gt;dht.begin — DHT22 return + DHT11 out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="378" width="300" height="50" as="geometry" /></mxCell><mxCell id="b6" value="battery.begin — divider ADC4 + gate 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="300" height="50" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;buzzer.begin + bz::powerOn — KY-012&lt;/b&gt;&lt;br&gt;2 beeps/s × 3 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="502" width="300" height="50" as="geometry" /></mxCell><mxCell id="b8" value="keypad.begin — PCF #1 @ 0x20" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="564" width="300" height="50" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b&gt;web::begin — hotspot + site&lt;/b&gt;&lt;br&gt;(ARCHITECTS OF SOLUTIONS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="626" width="300" height="50" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b&gt;scale.begin — HX711 1/2&lt;/b&gt;&lt;br&gt;(saved calibration restored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="688" width="300" height="50" as="geometry" /></mxCell><mxCell id="b11" value="&lt;b&gt;door::begin(false) — limit switch up,&lt;/b&gt;&lt;br&gt;lock stays LOW (init window)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="300" height="50" as="geometry" /></mxCell><mxCell id="b12" value="txdisp::begin — UART GPIO3 → UNO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="812" width="300" height="50" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b&gt;web::begin — hotspot + site&lt;/b&gt;&lt;br&gt;door begin(false) + clockBoot (NVS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="874" width="300" height="50" as="geometry" /></mxCell><mxCell id="b14" value="ArduinoOTA + mDNS — &quot;smart-dryer&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="936" width="300" height="50" as="geometry" /></mxCell><mxCell id="b15" value="&lt;b&gt;10 s INIT + CALIBRATION window&lt;/b&gt;&lt;br&gt;sensors/battery/scale settle · splash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="998" width="300" height="56" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;supply::engage + door::engage&lt;/b&gt;&lt;br&gt;relay = toggle · lock = state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1066" width="300" height="50" as="geometry" /></mxCell><mxCell id="b17" value="dryer.powerOn → IDLE (ready)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1128" width="300" height="50" as="geometry" /></mxCell><mxCell id="loophdr" value="② loop() — every pass (cooperative, 0 = DRYER_RTOS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="130" width="620" height="40" as="geometry" /></mxCell><mxCell id="looptasks" value="web::handle — site + captive DNS&lt;br&gt;ArduinoOTA.handle — IDE upload&lt;br&gt;sensors.update — AHT10 + DHT22 avg&lt;br&gt;battery.update — ADC (5 s)&lt;br&gt;dryer.tick — control core (1 s)&lt;br&gt;keypad.update → menu::key&lt;br&gt;scale.update — HX711 (2 Hz)&lt;br&gt;door::update — lock/limit workflow&lt;br&gt;supply::update — buttons/toggle/opto&lt;br&gt;dht.update — DHT11 outdoor (10 s)&lt;br&gt;rtc.sync — DS1302 boot restore · set-mirror&lt;br&gt;serviceSerial — console&lt;br&gt;serviceButton — BOOT btn (S3)&lt;br&gt;buzzer.update — beep edges&lt;br&gt;maybeAutoStart · maybeDiag (15 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="182" width="300" height="440" as="geometry" /></mxCell><mxCell id="compmap" value="COMPONENTS DRIVEN&lt;br&gt;&lt;br&gt;phone (hotspot site)&lt;br&gt;PC (OTA upload)&lt;br&gt;AHT10 + DHT22 (chamber)&lt;br&gt;battery divider&lt;br&gt;BTS7960 + 500 W coil&lt;br&gt;L298N + outlet fan&lt;br&gt;PCF #1 keypad&lt;br&gt;PCF #2 relays · buzzer · buttons&lt;br&gt;toggle · opto · door switch&lt;br&gt;HX711 + load cells&lt;br&gt;AT24C256 cycle registry&lt;br&gt;door limit switch&lt;br&gt;DHT11 outdoor sensor&lt;br&gt;DS1302 RTC (CR2032 coin cell)&lt;br&gt;phone/tablet (web display&lt;br&gt;+ full control page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="182" width="280" height="440" as="geometry" /></mxCell><mxCell id="tickhdr" value="③ dryer.tick() — the 1-second control core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="620" height="36" as="geometry" /></mxCell><mxCell id="t1" value="&lt;b&gt;state machine — IDLE → RUNNING →&lt;/b&gt;&lt;br&gt;COOLDOWN → DONE / FAULT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="692" width="290" height="56" as="geometry" /></mxCell><mxCell id="t2" value="&lt;b&gt;SAFETY: 95 °C hard cut ·&lt;/b&gt;&lt;br&gt;sensors dead 15 s → FAULT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="762" width="290" height="56" as="geometry" /></mxCell><mxCell id="t3" value="&lt;b&gt;WATCHDOGS: heater failure&lt;/b&gt;&lt;br&gt;(flat 3 min) · fan error (RH 5 min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="832" width="290" height="56" as="geometry" /></mxCell><mxCell id="t4" value="&lt;b&gt;heatStep — PID/boost duty&lt;/b&gt;&lt;br&gt;→ RPWM 12 (BTS7960 → coil)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="902" width="290" height="56" as="geometry" /></mxCell><mxCell id="t5" value="&lt;b&gt;fanStep — burst law&lt;/b&gt;&lt;br&gt;→ ENB 17 (L298N → fan)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="972" width="290" height="56" as="geometry" /></mxCell><mxCell id="t6" value="&lt;b&gt;target weight — T-5 min warn&lt;/b&gt;&lt;br&gt;+ suggestion (HX711 g/min)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1042" width="290" height="56" as="geometry" /></mxCell><mxCell id="t7" value="&lt;b&gt;completion gates —&lt;/b&gt;&lt;br&gt;time · RH · weight-rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1112" width="290" height="56" as="geometry" /></mxCell><mxCell id="t8" value="&lt;b&gt;cyclelog record (10 s)&lt;/b&gt;&lt;br&gt;→ LittleFS CSV (wt_g · mode)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1182" width="290" height="56" as="geometry" /></mxCell><mxCell id="states" value="EVENTS INTO THE MACHINE&lt;br&gt;&lt;br&gt;start() — refused until the scale is&lt;br&gt;calibrated (door gate) · captures&lt;br&gt;batch weight&lt;br&gt;stop() — user stop → purge&lt;br&gt;powerOn() — DONE/FAULT → IDLE&lt;br&gt;addMinutes(+15) — live&lt;br&gt;applyMode(0/1/2) — AGARBATTI /&lt;br&gt;USER / SILICAGEL presets&lt;br&gt;faultNow(&amp;quot;door opened!&amp;quot;)&lt;br&gt;setManualHeat(knob %, 60 s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="692" width="300" height="546" as="geometry" /></mxCell><mxCell id="webbox" value="④ web::handle — the website on the hotspot&lt;br&gt;/api/data 1 Hz JSON (everything) · /api/start 403-gated · /api/scale tare+cal&lt;br&gt;/api/mode presets · /api/settime phone clock · /api/heat knob (60 s)&lt;br&gt;/update OTA (refused while RUNNING) · /api/log.csv history · captive DNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1330" width="620" height="150" as="geometry" /></mxCell><mxCell id="dataflow" value="DATA FLOW&lt;br&gt;AHT10 → PID → PWM → coil&lt;br&gt;RH → burst law → fan&lt;br&gt;grams → gates + target&lt;br&gt;faults → beep + site + CSV&lt;br&gt;clock → NVS 30 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1330" width="340" height="150" as="geometry" /></mxCell><mxCell id="rtos" value="DRYER_RTOS 1 = the same work split into 5 FreeRTOS tasks: web @ core 0 · sensors / control / panel / power @ core 1 · Wire mutex protects the shared I2C bus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1250" width="1000" height="60" as="geometry" /></mxCell><mxCell id="files" value="FILE MAP — main.cpp (boot · loop · console · watchdogs) · control.* (state machine · PID · fan law · gates) · sensors/aht10.* · battery.* · buzzer.* · keypad.* (PCF #1) ·&lt;br&gt;scale.* (HX711) · door.* (workflow) · supply.* (latch · selector) · menu.* (keypad UI) · dht.* (DHT22 return + DHT11 out) · rtc.* (DS1302 clock) · web/webui (site — incl. /display kiosk) · cyclelog (CSV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1500" width="1000" height="110" as="geometry" /></mxCell><mxCell id="e2_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;strokeColor=#595959;" edge="1" pa